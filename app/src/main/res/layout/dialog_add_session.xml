<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speaker Details"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/add_speaker_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Speaker Name"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/add_speaker_company"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Company"
            android:layout_marginTop="8dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/add_speaker_bio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Biography"
            android:layout_marginTop="8dp"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Session Details"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/add_session_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Session Title"
            android:inputType="text" />

        <EditText
            android:id="@+id/add_session_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Room / Place"
            android:layout_marginTop="8dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/add_session_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select Time"
            android:layout_marginTop="8dp"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none" />

        <CheckBox
            android:id="@+id/add_session_vip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VIP Only Session"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
